# Portos do motor BTUN pré-ZTUN.
#
# Estes valores evitam colisão com a SCRIP_BASICA que já ocupa:
#   22 (OpenSSH), 80 (Proxy SOCKS), 90/110 (Dropbear),
#   443 (SSL Tunnel), 7300 (BADVPN).
#
# Para sobrescrever em uma VPS específica, edite este arquivo na máquina
# (ele é carregado pelo setup.sh/update.sh antes do install.sh).
BHTTP_PORT=7080
XHTTP_PORT=8443
BTUN_PORT=7027
BTUN_BHTTP_PORT=7081
BTUN_XHTTP_PORT=7443
